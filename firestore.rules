rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email in ["atendimento.spassessoria@gmail.com", "cainapribeiro@gmail.com", "atendimento@sprecursosadm.com.br"]) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (getUserData().role == "admin" || getUserData().role == "administrador"))
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
         getUserData().role in ["gestor", "supervisor", "analista", "atendente", "financeiro", "marketing"])
      );
    }

    // Default deny for undeclared collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Public institutional site configuration
    match /siteData/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Leads (Public create, Staff read/manage)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Solicitacoes & Clients (Public creation & protocol checking, Staff update)
    match /solicitacoes/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isStaff();
    }

    match /clients/{clientId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isStaff();
    }

    // User Profiles
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit Trail
    match /atividades/{id} {
      allow create, read, update: if true;
      allow delete: if isAdmin();
    }

    match /sent_emails/{id} {
      allow create, read, update: if true;
      allow delete: if isAdmin();
    }
  }
}
